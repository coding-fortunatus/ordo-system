# Environment for the Django services (migrate, api, worker, beat, backup) in
# deploy/compose.prod.yml. Copy to deploy/.env.prod on the VPS. Never commit
# the real file.

DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
PLATFORM_BASE_DOMAIN=ordo.app
# The console lives at <this>.<base>. Must match deploy/.env.
PLATFORM_CONSOLE_SUBDOMAIN=console
PLATFORM_URL_SCHEME=https
# Who gets platform alerts (failed setups and backups, renewals), comma
# separated. Empty means every active Owner.
PLATFORM_ALERT_EMAILS=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_TOTP_KEY=

# Postgres and Redis inside the stack. The password matches POSTGRES_PASSWORD
# in deploy/.env. For managed Postgres, point this at it (a direct, non
# pooled URL, since pg_dump and the migrate lock need one).
DATABASE_URL=postgres://ordo:CHANGE_ME@postgres:5432/ordo
REDIS_URL=redis://redis:6379/0

# Uploads (school logos). Required: local media is refused in production.
CLOUDINARY_URL=

# SMTP for invites and alerts, through Brevo's relay (deploy/README.md).
# The login and key are on Brevo's SMTP & API page; the login looks like
# xxxxxx@smtp-brevo.com, not your account email. The from address must be
# on a domain authenticated in Brevo.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ordo <no-reply@ordo.app>

# Final exports of deleted schools (private R2 bucket, kept until purge).
EXPORT_BUCKET=ordo-exports
EXPORT_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=

# Whole database backups (spec 0003, child 0007). A separate private R2
# bucket with a bucket lock and lifecycle rules (deploy/README.md). Set the
# BACKUP_S3_* keys to a token with Object Read & Write on this bucket only.
# The endpoint defaults to EXPORT_S3_ENDPOINT.
BACKUP_BUCKET=ordo-backups
# BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_TIME_UTC=01:00
# Ping URL of the outside monitor (e.g. a Healthchecks.io check, 24 hour
# period, 2 hour grace). Blank sends no pings.
BACKUP_HEARTBEAT_URL=

# Error observability (spec 0004). Errors, failed jobs and browser errors per
# school, in the console's Health page. Everything below is optional.
# OBSERVABILITY_ENABLED=True
# Counters use Redis; defaults to REDIS_URL.
# OBSERVABILITY_REDIS_URL=
# Status thresholds, per school per hour.
# OBS_FAILING_ERRORS=20
# OBS_JS_DEGRADED=10
# OBS_WS_SPIKE=20
# OBS_4XX_SPIKE_MIN=100
# OBS_4XX_SPIKE_FACTOR=3
# Browser error reports allowed per minute.
# OBS_JS_IP_PER_MIN=20
# OBS_JS_SCHOOL_PER_MIN=200
# Retention in days.
# OBS_EVENT_KEEP_DAYS=30
# OBS_BUCKET_KEEP_DAYS=90
# OBS_GROUP_KEEP_DAYS=90
