# Read by Docker Compose itself for deploy/compose.prod.yml (Traefik and
# Postgres). Copy to deploy/.env on the VPS. Never commit the real file.

PLATFORM_BASE_DOMAIN=ordo.app
# The console lives at <this>.<base>. Must match deploy/.env.prod.
PLATFORM_CONSOLE_SUBDOMAIN=console
# The marketing site. The bare domain and www redirect here.
SITE_URL=https://www.ordo.app

# Let's Encrypt account email, and a Cloudflare API token scoped to
# Zone > DNS > Edit on ordo.app only (DNS-01 for the wildcard certificate).
ACME_EMAIL=
CF_DNS_API_TOKEN=

POSTGRES_DB=ordo
POSTGRES_USER=ordo
# Long and random. Must match the password in DATABASE_URL in .env.prod.
POSTGRES_PASSWORD=

# Optional: pull prebuilt images instead of building on the VPS.
# API_IMAGE=ghcr.io/<you>/ordo-api:<tag>
# DASHBOARD_IMAGE=ghcr.io/<you>/ordo-dashboard:<tag>

# Memory cap of redis-obs, the telemetry buffer Redis (spec 0006). When it's
# full, new telemetry is dropped and counted; nothing else is affected.
# OBS_REDIS_MAXMEMORY=256mb
