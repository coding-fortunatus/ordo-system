# Local development. Copy to .env (never commit it). Everything except
# DATABASE_URL has a default that works locally (core/settings.py). Production
# uses deploy/.env.prod.example instead.

DEBUG=True
DATABASE_URL=postgres://ordo:ordo@localhost:5432/ordo
# Celery broker, Channels layer and observability counters.
REDIS_URL=redis://localhost:6379/0

# Schools live at <slug>.localhost, the console at console.localhost.
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_CONSOLE_SUBDOMAIN=console
PLATFORM_URL_SCHEME=http
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_TOTP_KEY=

# Email. Left empty, emails print to the console. Fill in to send real mail
# through Brevo (deploy/README.md, step 4).
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Ordo <no-reply@ordo.app>

# Uploads. Empty keeps them in media/ locally.
# CLOUDINARY_URL=

# Error observability (spec 0004).
# OBSERVABILITY_ENABLED=True
